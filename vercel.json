{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/download_deployment_model.py",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "fluid": true,
  "regions": ["bom1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{notebooks/**,tests/**,deliverables/**,docs/**,.paper-audit/**,.paper-build/**,.pptx-build/**,Synopsis Template12.pptx}"
    }
  }
}
